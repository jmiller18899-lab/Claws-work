FROM ghcr.io/anomalyco/opencode:1.18.17

USER root
RUN apk add --no-cache git openssh-client ca-certificates

WORKDIR /workspace
COPY . /workspace

ENTRYPOINT []
EXPOSE 4096
CMD ["sh", "-lc", "mkdir -p /tmp/health/global; printf 'ok\\n' > /tmp/health/global/health; busybox httpd -h /tmp/health -p \"$PORT\"; exec opencode serve --hostname 0.0.0.0 --port 4096"]
